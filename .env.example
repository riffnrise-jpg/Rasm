# ──────────────────────────────────────────────────────────
# Rasm — environment variables (server-side only)
# Copy this file to `.env` and fill in real values.
# NEVER prefix these with VITE_ — they must never reach the client bundle.
# ──────────────────────────────────────────────────────────

# Google Cloud project that has the Vertex AI API enabled.
GOOGLE_PROJECT_ID=your-gcp-project-id

# Service account JSON key (the full file contents, as a single-line JSON string)
# The service account needs the "Vertex AI User" role.
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Google Cloud region hosting the Veo model endpoint.
GOOGLE_LOCATION=us-central1

# Veo model identifier on Vertex AI (update to the version you have access to).
VEO_MODEL_ID=veo-3.0-generate-preview
